# legacy-peer-deps, for one reason: @bacons/apple-targets vendors an
# @expo/require-utils whose OPTIONAL peer wants typescript ^5, and this
# project is on 6. npm 11 (this machine) accepts that quietly; the npm
# on EAS's build image computes that a nested typescript@5.9.3 belongs
# in the lockfile and fails `npm ci` with "Missing from lock file".
# Same npm behaviour everywhere, chosen here, is the fix — remove this
# when the plugin's dependency widens its peer range past 5.
legacy-peer-deps=true
