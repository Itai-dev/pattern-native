{
  "expo": {
    "name": "Pattern",
    "slug": "pattern",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.itaiagami.pattern",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.itaiagami.pattern",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Pattern reads only the Health data you choose — sleep, activity, workouts, heart, State of Mind — to add context beside your pain record. It never writes to Health, and everything it reads stays on this iPhone.",
          "NSHealthUpdateUsageDescription": "Pattern never writes to Apple Health and never asks for write access. This text exists only because the underlying library includes write APIs; you will not see a write permission request.",
          "background": false
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "defaultChannel": "reminders"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "WeekWidget",
              "displayName": "Last 7 days",
              "description": "The shape of your week, and a tap to check in.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ]
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f5e7cd7c-e6e3-4c5c-83e6-2862baf6b8d8"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/f5e7cd7c-e6e3-4c5c-83e6-2862baf6b8d8"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "scheme": "pattern",
    "platforms": [
      "ios",
      "android"
    ]
  }
}
